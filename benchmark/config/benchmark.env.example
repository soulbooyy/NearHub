# Copy to benchmark/.env. bootstrap.sh creates random passwords if this file is absent.
# These ports belong exclusively to the nearhub-benchmark Compose project.
BENCH_PROJECT=nearhub-benchmark
# Explicit opt-in; only the external benchmark launcher disables timeout sends/cancellations.
BENCH_CREATE_ONLY=false
MYSQL_PASSWORD=replace_with_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_random_password
MYSQL_PORT=33306
REDIS_PORT=36379
NAMESRV_PORT=39876
SERVER_PORT=18081
# Leave blank to use repository .local/jdk8/Contents/Home or .local/jdk8.
APP_JAVA_HOME=
# Empty means retain JVM ergonomics; no implicit heap/pool/thread tuning.
APP_JAVA_OPTS=
# JMeter may use a different JDK (Java 17 recommended for the local client).
JMETER_JAVA_HOME=
JMETER_HEAP=-Xms256m -Xmx1g
# Lightweight DB/Redis samples, slower Docker/JVM/MQ samples (seconds).
SAMPLE_SECONDS=5
MQ_SAMPLE_SECONDS=30
