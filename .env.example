# Local development only. Loaded by Docker Compose and scripts/dev.sh.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=hmdp
MYSQL_USER=hmdp
MYSQL_PASSWORD=hmdp_local_dev
MYSQL_ROOT_PASSWORD=hmdp_local_root
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
# Initial delivery + at most 3 retries; failures then go to the consumer group's DLQ.
ORDER_MAX_RECONSUME_TIMES=3
# Expiring transaction success marker and MQ check grace (not a global consistency guarantee).
SECKILL_TX_MARKER_TTL_SECONDS=86400
SECKILL_TX_CHECK_GRACE_MS=60000
SERVER_PORT=8081
# Shop cache: local expiry and Redis logical expiry base (plus up to 20% jitter).
SHOP_LOCAL_TTL_SECONDS=60
SHOP_REDIS_LOGICAL_TTL_SECONDS=300
# Optional: HMDP_UPLOAD_DIR=/absolute/path/to/uploads
# Optional: JAVA_HOME=/absolute/path/to/jdk8/Contents/Home
